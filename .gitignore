# This repo is public: secrets, client data and scratch files stay out of Git.
# The pre-commit and pre-push secret scan (npm run hooks:install) enforces it.
gen-lang-client-*.json
*service-account*.json
*.sa.json
*.pem
*.p12
secrets/
production.env
fixtures-private/

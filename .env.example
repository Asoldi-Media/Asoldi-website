# GEMINI_API_KEY: Required for Gemini AI API calls.
# Production: set keys in Hostinger → asoldi.com → Environment variables (not Git).
# After boot, asoldi.com also copies them to ~/.asoldi-website-data/production.env.
# Set in Hostinger/env or .env.local (never commit .env.local with real values).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (optional).
APP_URL="MY_APP_URL"

# LAN Docker preview (PC2). Used when Asoldi + Website Maker run on the LAN host.
# WEBSITE_MAKER_LOCAL_URL=http://192.168.68.92:3000
# WEBSITE_MAKER_BASE_URL=http://192.168.68.92:3000
# APP_URL=http://192.168.68.92:3200
# Public client/meeting preview (Website Maker pushes after Step 1):
#   https://asoldi.com/previews
#   https://asoldi.com/sales-preview/<sales-client-id>/

# Client portal — Google Sign-In (kunde login at /login/kunde)
# CLIENT_GOOGLE_CLIENT_ID=
# CLIENT_GOOGLE_CLIENT_SECRET=
# Optional override; default is APP_URL + /api/client/auth/google/callback
# CLIENT_GOOGLE_REDIRECT_URI=https://asoldi.com/api/client/auth/google/callback
# Set to 0 when real Google OAuth is configured (default 1 = dev stub for Facebook)
# CLIENT_SOCIAL_DEV_MODE=0

# Client onboarding — browser Places Text Search (public name + Place ID + Maps URL).
# Restrict the key to HTTP referrers: https://asoldi.com/* and http://localhost:*
# Enable "Maps JavaScript API" and "Places API (New)". Legacy Places API is the fallback.
# GOOGLE_MAPS_API_KEY=

# Optional persistent runtime storage path.
# On Hostinger the app defaults to ~/.asoldi-website-data (or APP_DATA_DIR).
# APP_DATA_DIR=
# How many timestamped copies to keep in backups/ per JSON file (default 5).
# 0 = only keep *.latest.json. The live files are the sibling *.json in this dir.
# DATA_BACKUP_KEEP=5

# Admin CMS (domain.com/admin). Change in production.
# ADMIN_USERNAME=asoldi.com
# ADMIN_PASSWORD=your-secure-password
# ADMIN_SECRET=long-random-string-for-jwt-signing
#
# Desired @damianhch/client-cms version returned to every client via site-config
# (fleet updates compare this to each site's heartbeat packageVersion).
# CMS_DESIRED_PACKAGE_VERSION=1.1.0
# Optional: this site as a hub client of itself
# CMS_SITE_KEY=
#
# Pull Admin users + sales clients FROM live asoldi.com into local/LAN JSON.
# One-way mirror only (see docs/runtime-data.md). Never writes back to production.
# PROD_ADMIN_URL=https://asoldi.com
# PROD_ADMIN_USERNAME=asoldi.com
# PROD_ADMIN_PASSWORD=
# LAN_USER_SYNC_PASSWORD=
# On LAN, PROD_ADMIN_* is the fallback so Website Maker can push a client ZIP
# to asoldi.com/sales-preview/:client when the callback token is missing.
# Instant push lives on the Maker run page: "Update public website now".
# SALES_PREVIEW_PUBLIC_BASE=https://asoldi.com
# SALES_PREVIEW_PUSH_URL=https://asoldi.com/api/admin/sales/maker-preview-push
#
# LAN Docker must keep MyPhoner webhooks on asoldi.com:
# MYPHONER_WEBHOOK_RECONCILE_ENABLED=0
# MYPHONER_WEBHOOK_BASE_URL=https://asoldi.com

# For local dev with Vite: run API on port 3001 so Vite can proxy /api.
# PORT=3001

# Firebase: copy firebase-applet-config.example.json to firebase-applet-config.json
# and fill in values from Firebase Console. Do not commit real API keys.

# Live client contact forms (POST /api/client-forms/:siteKey) use the same mailer.
# Do NOT send app mail through smtp.hostinger.com. Hostinger treats Node SMTP logins as
# a stolen mailbox and disables outgoing after a few sends. Keep the Hostinger mailbox
# for receiving/replies only. Send through Resend (or another transactional provider).
# RESEND_API_KEY=
# RESEND_FROM=Asoldi <kontakt@asoldi.com>
# Fathom meeting recordings → ansatte@asoldi.com (POST /api/webhooks/fathom?token=...)
# FATHOM_WEBHOOK_TOKEN=
# FATHOM_NOTIFY_EMAIL=ansatte@asoldi.com
# Optional comma-separated Fathom signing secrets (whsec_...) if you verify signatures too.
# FATHOM_WEBHOOK_SECRET=
# Fireflies meeting recordings → ansatte@asoldi.com (POST /api/webhooks/fireflies?token=...)
# FIREFLIES_WEBHOOK_TOKEN=
# FIREFLIES_NOTIFY_EMAIL=ansatte@asoldi.com
# Optional HMAC signing secret for X-Hub-Signature (paste the same value in Fireflies webhook settings).
# FIREFLIES_WEBHOOK_SECRET=
# Required to pull video URL + transcript after Fireflies posts only a meeting id.
# FIREFLIES_API_KEY=
# Notetaker invited to the first online sales meeting only (not next-action reminders). Default fred@fireflies.ai. Set 0 to skip.
# FIREFLIES_NOTETAKER_EMAIL=fred@fireflies.ai
# Max size (MB) of the meeting video/audio copied to the data dir per meeting (0 disables downloads). Default 400.
# FIREFLIES_MEDIA_MAX_MB=400
# Media library (Admin -> Manage website -> Media). Files are stored in <data dir>/media and served at /media/<name>.
# Max upload size in MB. Default 300.
# HUB_MEDIA_MAX_MB=300
# DeepSeek powers "Fyll ut med kundedetaljer" and "Speil e-post i kontrakt" in the offer (tilbud) flow.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USER=kontakt@asoldi.com
# SMTP_PASS=
# SMTP_FROM=Asoldi <kontakt@asoldi.com>
# SMTP_REPLY_TO=daracha777@gmail.com
# Optional BCC so API-sent mail is visible in the SMTP mailbox inbox.
# SMTP_BCC=contact@asoldi.com
# Always BCC sales meeting emails here (welcome + reminders). Defaults to daracha777@gmail.com.
# SALES_EMAIL_COPY_TO=daracha777@gmail.com
# Optional fallback SMTP (used only when primary SMTP send fails).
# SMTP_FALLBACK_HOST=smtp.gmail.com
# SMTP_FALLBACK_PORT=587
# SMTP_FALLBACK_USER=daracha777@gmail.com
# SMTP_FALLBACK_PASS=
# SMTP_FALLBACK_FROM=Asoldi <daracha777@gmail.com>
# SMTP_FALLBACK_REPLY_TO=kontakt@asoldi.com

# Sales/booking inbox routing.
# Primary recipient for website booking inquiries.
# BOOKING_INBOX_EMAIL=kontakt@asoldi.com
# Optional reply-to for booking submissions.
# BOOKING_REPLY_TO=daracha777@gmail.com
# Contact shown in Website Maker sales-intake metadata (salesContact).
# SALES_CONTACT_EMAIL=kontakt@asoldi.com

# Employee dashboard integrations.
# WordPress sync (imports employee users with employee/ansatt role).
# WORDPRESS_URL=https://asoldi.com
# WORDPRESS_USERNAME=
# WORDPRESS_APP_PASSWORD=

# MyPhoner sync (campaign/list IDs can be comma-separated).
# MYPHONER_API_KEY=
# MYPHONER_SUBDOMAIN=
# MYPHONER_CAMPAIGN_ID=
# Incoming webhook secret (separate from API key). Required for winner auto-intake.
# MYPHONER_WEBHOOK_SECRET=
# Public base URL used when auto-registering webhook targets.
# Defaults to APP_URL when omitted.
# MYPHONER_WEBHOOK_BASE_URL=
# Enable/disable automatic webhook reconciliation loop (default 1).
# MYPHONER_WEBHOOK_RECONCILE_ENABLED=1
# How often to reconcile list/account webhooks (milliseconds, default 600000 = 10 min).
# MYPHONER_WEBHOOK_RECONCILE_MS=600000
# Replay window for duplicate webhook deliveries (milliseconds, default 120000 = 2 min).
# MYPHONER_WEBHOOK_REPLAY_WINDOW_MS=120000
# Call-recording sync: download Myphoner audio into durable local storage (default 1).
# MYPHONER_RECORDING_DOWNLOAD_ENABLED=1
# Pending recording retry tick interval (ms, default 30000).
# MYPHONER_RECORDING_RETRY_TICK_MS=30000
# Max poll attempts per call while waiting for recordings[] to appear (default 12).
# MYPHONER_RECORDING_RETRY_MAX_ATTEMPTS=12
# Owner key used when Myphoner creates new Sales clients automatically.
# MYPHONER_DEFAULT_SALES_OWNER_KEY=admin:daracha777@gmail.com
# Comma-separated MyPhoner list IDs whose winners go into the SSU sales bracket (not websites).
# Default already includes the known SSU list id 210172.
# MYPHONER_SSU_LIST_IDS=210172
# Target MyPhoner list that receives a copy of every SSU winner (new funnel).
# Default already includes the known "SSU wins" list id 216843.
# MYPHONER_SSU_WINS_LIST_IDS=216843
# MYPHONER_SSU_WINS_LIST_NAME=SSU wins
# Copy SSU winners into SSU wins on webhook + startup/reconcile catch-up (default 1).
# MYPHONER_SSU_WINS_SYNC_ENABLED=1
# Enable automatic post-winner enrichment of missing Sales links
# (google business from metadata; proff resolved from orgnr to concrete company profile URL;
# instagram/facebook via deterministic web search + fallback rules).
# MYPHONER_AUTO_LINK_ENRICH=1
# Timeout per outbound search request in milliseconds (default 6000).
# MYPHONER_AUTO_LINK_ENRICH_TIMEOUT_MS=6000
# Cache TTL for repeated search queries in milliseconds (default 21600000 = 6h).
# MYPHONER_AUTO_LINK_SEARCH_CACHE_MS=21600000
# SerpAPI keys for Instagram/Facebook discovery and client Google-profile search.
# REQUIRED for reliable Google results. Without it, enrichment falls back to Brave HTML
# scraping (weaker) and often leaves Instagram/Facebook empty (preferred over wrong links).
# Keep server-side only; never expose in client code.
# SERPAPI_API_KEY=
# Optional second SerpAPI account. Used when the first plan is out of searches.
# SERPAPI_API_KEY_2=
# Optional SerpAPI engine override (default google).
# SERPAPI_ENGINE=google
# Optional SerpAPI request timeout in milliseconds (default 15000; site: queries can be slow
# and a short timeout silently drops the best results).
# SERPAPI_TIMEOUT_MS=15000
# Minimum delay between SerpAPI requests to avoid provider throttling during large backfills.
# SERPAPI_MIN_INTERVAL_MS=900
# Retry settings for transient SerpAPI throttling/network errors.
# SERPAPI_RETRY_LIMIT=3
# SERPAPI_RETRY_BACKOFF_MS=1200
# Locale hints for Google results (defaults to Norway: no/no).
# SERPAPI_HL=no
# SERPAPI_GL=no
# DataForSEO Google Maps SERP (client analytics local ranking, every 14 days).
# Use the same API access as Website Maker. Maps live/advanced only — not Labs keywords.
# DATAFORSEO_AUTH=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# DATAFORSEO_MAPS_BUDGET_USD=50
# DATAFORSEO_MAPS_DEPTH=20
# MAPS_RANKING_INTERVAL_DAYS=14
# Google Business Profile OAuth (client settings). Same Google Cloud client as client login, extra redirect URI.
# CLIENT_GOOGLE_BUSINESS_REDIRECT_URI=https://asoldi.com/api/client/google-business/callback
# Brave HTML is not used for sales links. SerpAPI name-matches first.
# One Gemini 2.5 Flash Google Search call fills Instagram, Facebook, website, or Maps
# only when that search did not already confirm a link.
# SALES_LINK_GEMINI_MODEL=gemini-2.5-flash
# SOCIAL_BRAVE_FALLBACK_ENABLED=0
# SOCIAL_BRAVE_TIMEOUT_MS=3500
# SOCIAL_BRAVE_MIN_INTERVAL_MS=250
# SOCIAL_BRAVE_MAX_LINKS=80
# Strict confidence controls for social link auto-save.
# Higher values reduce false positives (more links will be skipped).
# Defaults: score=4 (auto-scales down for 1-2 word names), margin=2, tokenMatches=2.
# MYPHONER_SOCIAL_CONFIDENCE_MIN_SCORE=4
# MYPHONER_SOCIAL_CONFIDENCE_MIN_MARGIN=2
# MYPHONER_SOCIAL_CONFIDENCE_MIN_TOKEN_MATCHES=2
# Force-fill missing Instagram/Facebook from a business-name slug.
# Default OFF — enabling this invents handles and causes wrong profile links.
# Opposite-platform mirroring (IG↔FB) only saves a URL after the same SerpAPI confidence check.
# MYPHONER_SOCIAL_FORCE_FILL=0
# Maximum pages pulled per Myphoner list when rebuilding lead catalog for relink/backfill.
# Increase for older/larger lists if some leads cannot be found by relink.
# MYPHONER_LEAD_CATALOG_MAX_PAGES=25
# Startup backfill for existing Sales clients (runs once per version and stores completion stamp).
# Keep enabled to auto-populate legacy rows after deploy.
# SALES_LINK_BACKFILL_ENABLED=1
# Bump version string to force a new one-time startup backfill pass.
# SALES_LINK_BACKFILL_VERSION=social-links-v7-proff-from-orgnr
# Optional safety limit for each backfill run (0 = no limit).
# SALES_LINK_BACKFILL_LIMIT=0

# Luca Regnskap sync.
# LUCA_API_KEY=
# LUCA_COMPANY_ID=

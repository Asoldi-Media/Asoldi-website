{
  "name": "onboarding",
  "description": "New client accounts go through onboarding in both portal versions: register, read the state, fill the profile and finish onboarding.",
  "steps": [
    { "name": "register (portal v2)", "method": "POST", "path": "/api/client-auth/register", "expect": 201,
      "body": { "email": "onboarding-v2@example.com", "password": "dark-diff-onboarding-pass-1" }, "save": { "v2Token": "body.token" } },
    { "name": "who am I (portal v2)", "method": "GET", "path": "/api/client-auth/me", "auth": "bearer:v2Token", "expect": 200 },
    { "name": "save the profile (portal v2)", "method": "PUT", "path": "/api/client-auth/profile", "auth": "bearer:v2Token", "expect": 200,
      "body": { "name": "Per Example", "businessName": "Example Onboarding AS" } },
    { "name": "read the portal state", "method": "GET", "path": "/api/client-portal/state", "auth": "bearer:v2Token", "expect": 200 },
    { "name": "finish onboarding", "method": "PATCH", "path": "/api/client-portal/state", "auth": "bearer:v2Token", "expect": 200, "body": { "onboardingComplete": true } },
    { "name": "sign up (portal v1)", "method": "POST", "path": "/api/client/auth/signup", "expect": 201,
      "body": { "email": "onboarding-v1@example.com", "password": "dark-diff-onboarding-pass-2" }, "save": { "v1Token": "body.token" } },
    { "name": "fill the onboarding profile", "method": "PUT", "path": "/api/client/profile", "auth": "bearer:v1Token", "expect": 200,
      "body": { "name": "Per Example", "businessName": "Example Onboarding Two AS", "position": "Daglig leder", "discoveryChannel": "google", "onboardingCompleted": true } },
    { "name": "the dashboard after onboarding", "method": "GET", "path": "/api/client/dashboard", "auth": "bearer:v1Token", "expect": 200 },
    { "name": "the settings after onboarding", "method": "GET", "path": "/api/client/settings", "auth": "bearer:v1Token", "expect": 200 }
  ]
}

{
  "description": "Routes the route probe calls without credentials. staff: must answer 401 or 403. dark: must answer 404 while its switch is off. Add a row for every new staff route or switched-off route a push brings.",
  "routes": [
    { "method": "GET", "path": "/api/admin/email/status", "expect": "staff" },
    { "method": "PUT", "path": "/api/admin/email/settings", "body": { "enabled": true }, "expect": "staff" },
    { "method": "POST", "path": "/api/admin/email/sites/site-x/provision", "body": {}, "expect": "staff" },
    { "method": "POST", "path": "/api/admin/email/suppressions/rebuild", "body": { "force": true }, "expect": "staff" },
    { "method": "GET", "path": "/api/admin/email/owner-routing/preview", "expect": "staff" },
    { "method": "PUT", "path": "/api/admin/email/owner-routing/default", "body": { "enabled": true, "siteIds": [] }, "expect": "staff" },
    { "method": "GET", "path": "/api/admin/sales-clients/sc-x/seo", "expect": "staff" },
    { "method": "PUT", "path": "/api/admin/sales-clients/sc-x/seo", "body": { "agreedKeywords": [] }, "expect": "staff" },
    { "method": "POST", "path": "/api/admin/sales-clients/sc-x/seo/approve", "body": { "phrase": "x" }, "expect": "staff" },
    { "method": "POST", "path": "/api/admin/sales-clients/sc-x/seo/block", "body": { "phrase": "x" }, "expect": "staff" },
    { "method": "GET", "path": "/api/admin/legal/terms-update", "expect": "dark" },
    { "method": "POST", "path": "/api/hub/email/provision-request", "body": {}, "expect": "dark" },
    { "method": "POST", "path": "/api/hub/email/provision/confirm", "body": {}, "expect": "dark" },
    { "method": "GET", "path": "/api/hub/email/unsubscribe", "expect": "dark" },
    { "method": "GET", "path": "/api/internal/maker/seo-record?salesClientId=x", "expect": "dark" },
    { "method": "GET", "path": "/api/legal/texts/vilkar", "expect": "dark" },
    { "method": "GET", "path": "/api/client/legal", "expect": "dark" }
  ]
}

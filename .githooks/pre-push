#!/bin/sh
# A push to main deploys asoldi.com. Refuse it when any commit being pushed (its lines, its
# message or the lines written while resolving a merge) adds a secret or client data, or when
# npm test fails. git passes the refs on stdin.
# Installed with: npm run hooks:install
node scripts/security/secret-scan.mjs --pre-push
status=$?
if [ "$status" -eq 1 ]; then
  echo "pre-push: the secret scan found something; push refused."
  exit 1
elif [ "$status" -ne 0 ]; then
  echo "pre-push: the secret scan could not run (exit $status); push refused."
  exit 1
fi
# npm test gets a throwaway data dir: a few older tests fall back to ~/.asoldi-website-data,
# which on the operator PC is the local hub data.
test_data=$(mktemp -d 2>/dev/null) || test_data=""
if [ -z "$test_data" ] || [ ! -d "$test_data" ]; then
  echo "pre-push: could not create a temp data dir for npm test; push refused."
  exit 1
fi
APP_DATA_DIR="$test_data" DATA_DIR="" PERSIST_PRODUCTION_ENV=0 npm test
status=$?
rm -rf "$test_data"
if [ "$status" -ne 0 ]; then
  echo "pre-push: npm test failed; push refused."
  exit 1
fi
